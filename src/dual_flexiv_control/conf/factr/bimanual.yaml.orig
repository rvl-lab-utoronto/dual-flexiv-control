defaults:
- base_factr
- _self_
servers:
  left:
    host: localhost
    port: 5000
    endpoint: ws/left
    request_timeout_s: 0.5
    dof: 8
  right:
    host: localhost
    port: 5001
    endpoint: ws/right
    request_timeout_s: 0.5
    dof: 8
leaders:
  left:
    raw_to_dfc:
      offsets_deg:
      - 0.13
      - -173.91
      - 94.9
      - 174.08
      - -0.22
      - -69.38
      - -179.03
      sign_flip_joints:
      - 6
      wrap_deg: true
      drop_trailing: 1
      gripper_open: 1.0953
      gripper_closed: 1.4926
    home_q_rad:
    - 0.031414563
    - -0.0087580076
    - 0.0947250181
    - 1.55490974
    - -0.0237814746
    - -1.2124434158
    - -0.0966966947
    dfc_to_factr:
      signs:
      - 1
      - 1
      - 1
      - 1
      - 1
      - -1
      - 1
      offset_rad:
      - -0.031414563
      - 0.0087580076
      - -0.0947250181
      - 0.01509026
      - 0.0237814746
      - 1.2124434158
      - -0.0966966947
  right:
    raw_to_dfc:
      offsets_deg:
      - -93.13
      - -47.02
      - 90.26
      - -150.64
      - -2.99
      - 177.69
      - 97.96
      sign_flip_joints: []
      wrap_deg: true
      drop_trailing: 1
      gripper_open: 2.4
      gripper_closed: 3.0
    home_q_rad:
    - -0.0874150883
    - 0.0474715921
    - -0.0936000988
    - 1.5768763449
    - 0.0291333631
    - 0.1166438991
    - 0.0476202178
    dfc_to_factr:
      signs:
      - 1
      - 1
      - 1
      - 1
      - 1
      - 1
      - 1
      offset_rad:
      - 0.0874150883
      - -0.0474715921
      - 0.0936000988
      - -0.0068763449
      - -0.0291333631
      - -0.1166438991
      - -0.0476202178
launch:
  enabled: true
  workdir: ~/FACTR-Server/FACTR_Teleop
  teleop_modules:
    left: src.factr_teleop.factr_teleop.factr_rizon_teleop
    right: src.factr_teleop.factr_teleop.factr_rizon_dual_board
